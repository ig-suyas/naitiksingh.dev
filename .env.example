# Public URL of the deployed site (used for canonical URLs, OG images, sitemap).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form email delivery (https://resend.com). Leave unset to use the mailto fallback.
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=naitiksingh.dev@gmail.com
# Must be a sender on a domain you verified in Resend. Until then use Resend's test sender.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
